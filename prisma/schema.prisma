generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase Postgres. Use the POOLED connection string (port 6543) with
  // `?pgbouncer=true` — serverless functions open and drop connections
  // constantly, and the pooler is what keeps a hall full of students from
  // exhausting Postgres' connection limit.
  //
  // No `directUrl` here on purpose: it would require a second env var to be
  // present at build time or `prisma generate` fails, and schema changes are
  // applied through supabase/migrations/*.sql rather than `prisma migrate`.
  url      = env("DATABASE_URL")
}

// ============================================================
// COMPETITION SETTINGS
// ============================================================
model CompetitionSettings {
  id                  String   @id @default(cuid())
  name                String   @default("Islamic Quiz Competition")
  schoolName          String   @default("M.E.S. English Medium School")
  description         String?
  currentRound        Int      @default(0)
  competitionStatus   String   @default("draft") // draft, test, live, paused, completed
  round1Status        String   @default("locked") // locked, open, paused, closed
  round2Status        String   @default("locked")
  round1StartAt       DateTime?
  round1EndAt         DateTime?
  round2StartAt       DateTime?
  round2EndAt         DateTime?
  round1TotalQuestions Int     @default(10)
  round1TimeLimit     Int      @default(0) // 0 = no limit, in seconds
  round2TimeLimit     Int      @default(60) // in seconds
  allowRound2Retry    Boolean  @default(true)
  round2PenaltySeconds Int     @default(5)
  isTestMode          Boolean  @default(false)

  // ---------- ROUND 2 LIVE (admin-gated, one question at a time) ----------
  // "live" = admin releases questions one by one, leaderboard between each
  // "free" = legacy self-paced drag-and-drop speed challenge
  round2Mode             String    @default("live")
  // Round 2 entry gate. Qualification decides WHO may compete; the PIN decides
  // WHERE they must be sitting to join, because it is shown only on the
  // projector. Neither stops a phone-a-friend — only invigilation does.
  round2QualifyTopN      Int       @default(20)
  round2JoinPin          String?
  round2RequirePin       Boolean   @default(true)
  round2RequireQualify   Boolean   @default(true)
  // 0 = nothing released yet. Otherwise the questionNumber currently on the board.
  round2CurrentQuestion  Int       @default(0)
  // idle -> open -> locked -> revealed -> (next) open ...
  round2QuestionState    String    @default("idle")
  // Server-authoritative clock reference. responseTimeMs is measured from this.
  round2QuestionOpenedAt DateTime?
  round2QuestionLockedAt DateTime?
  // Per-question countdown shown to participants. 0 = no auto-close, admin locks manually.
  round2QuestionSeconds  Int       @default(30)
  // When true, the reveal screen shows the correct option to participants.
  round2ShowAnswer       Boolean   @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ============================================================
// ADMIN USERS
// ============================================================
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // hashed password
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// PARTICIPANTS
// ============================================================
model Participant {
  id              String   @id @default(cuid())
  participantCode String   @unique
  name            String
  // The school the student represents. Replaces class/division, which are no
  // longer collected at registration.
  schoolName      String   @default("M.E.S. English Medium School")
  className       String?
  division        String?
  // "gujarati" is the historic key for the second language; the content and the
  // UI label are now Hindi (Devanagari).
  language        String   @default("english")
  // Set by the admin when the Round 1 cut is applied.
  round2Eligible  Boolean  @default(false)
  round2JoinedAt  DateTime?
  // Lets the quiz master remove someone mid-round without deleting their data.
  disqualified    Boolean  @default(false)
  isTest          Boolean  @default(false)
  createdAt       DateTime @default(now())

  round1Attempts  Round1Attempt[]
  round2Attempts  Round2Attempt[]
  round2LiveAnswers Round2LiveAnswer[]
  round2LiveStarts  Round2LiveStart[]

  @@index([round2Eligible])
  @@index([disqualified])
}

// ============================================================
// QUESTIONS
// ============================================================
model Question {
  id              String   @id @default(cuid())
  questionNumber  Int
  englishQuestion String
  gujaratiQuestion String
  optionAEnglish  String
  optionBEnglish  String
  optionCEnglish  String
  optionDEnglish  String
  optionAGujarati String
  optionBGujarati String
  optionCGujarati String
  optionDGujarati String
  correctOption   String   // A, B, C, D
  marks           Int      @default(1)
  round           Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  round1Answers   Round1Answer[]

  @@unique([round, questionNumber])
  @@index([round, isActive])
}


// ============================================================
// ROUND 1 ATTEMPTS
// ============================================================
model Round1Attempt {
  id                String   @id @default(cuid())
  participantId     String
  startedAt         DateTime @default(now())
  submittedAt       DateTime?
  completionTimeMs  Int?
  score             Int?
  totalQuestions    Int?
  correctAnswers    Int?
  incorrectAnswers  Int?
  status            String   @default("in_progress") // in_progress, submitted, invalidated
  isTest            Boolean  @default(false)
  createdAt         DateTime @default(now())

  participant       Participant @relation(fields: [participantId], references: [id])
  answers           Round1Answer[]

  @@index([participantId])
  @@index([score])
  @@index([completionTimeMs])
  @@index([submittedAt])
  @@index([status])
  @@index([isTest])
}

// ============================================================
// ROUND 1 ANSWERS
// ============================================================
model Round1Answer {
  id              String @id @default(cuid())
  attemptId       String
  questionId      String
  selectedOption  String
  isCorrect       Boolean?
  answeredAt      DateTime @default(now())

  attempt         Round1Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question      @relation(fields: [questionId], references: [id])

  @@index([attemptId])
  @@index([questionId])
}

// ============================================================
// ROUND 2 CHALLENGES
// ============================================================
model Round2Challenge {
  id             String   @id @default(cuid())
  challengeNumber Int
  prompt         String
  items          String   // JSON array: ["Y","Z","X","V","U","W"]
  correctOrder   String   // JSON array: ["U","V","W","X","Y","Z"]
  timeLimitMs    Int      @default(60000)
  isActive       Boolean  @default(true)
  maxAttempts    Int      @default(3)
  createdAt      DateTime @default(now())

  attempts       Round2Attempt[]
}

// ============================================================
// ROUND 2 ATTEMPTS
// ============================================================
model Round2Attempt {
  id              String   @id @default(cuid())
  participantId   String
  challengeId     String
  startedAt       DateTime @default(now())
  submittedAt     DateTime?
  clientElapsedMs Int?
  serverElapsedMs Int?
  attemptNumber   Int      @default(1)
  isCorrect       Boolean?
  penaltyMs       Int      @default(0)
  finalTimeMs     Int?
  status          String   @default("started") // started, correct, incorrect, expired, invalidated
  isTest          Boolean  @default(false)
  submittedOrder  String?  // JSON array of submitted order
  createdAt       DateTime @default(now())

  participant     Participant    @relation(fields: [participantId], references: [id])
  challenge       Round2Challenge @relation(fields: [challengeId], references: [id])

  @@index([participantId])
  @@index([challengeId])
  @@index([finalTimeMs])
  @@index([submittedAt])
  @@index([status])
  @@index([isTest])
}

// ============================================================
// ROUND 2 LIVE QUESTIONS
// Round 2 is an ORDERING round: students arrange a set of items
// into the correct sequence. Scoring is all-or-nothing.
// ============================================================
model Round2LiveQuestion {
  id             String   @id @default(cuid())
  questionNumber Int      @unique
  // "order" = arrange items into a sequence.
  // "mcq" is supported by the same engine so a multiple-choice question can be
  // dropped into the live flow later without a migration.
  type           String   @default("order")
  titleEnglish   String
  titleSecondary String?
  promptEnglish  String
  promptSecondary String?
  // JSON array, in display order:
  // [{"key":"al-balad","en":"Al-Balad","ar":"البلد","hi":"अल-बलद"}, ...]
  items          String
  // JSON array of item keys in the correct sequence.
  correctOrder   String
  // Only used when type = "mcq".
  correctOption  String?
  marks          Int      @default(1)
  timeLimitSec   Int      @default(120)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  answers        Round2LiveAnswer[]
  starts         Round2LiveStart[]

  @@index([isActive])
}

// ============================================================
// ROUND 2 LIVE ANSWERS
// One row per participant per question. The @@unique constraint is the
// one-shot guarantee: a participant physically cannot answer twice, even
// if they double-tap, refresh, or open a second tab.
// ============================================================
model Round2LiveAnswer {
  id               String   @id @default(cuid())
  participantId    String
  questionId       String
  questionNumber   Int
  answerType       String   @default("order")
  // JSON array of item keys in the order the student submitted them.
  submittedOrder   String?
  selectedOption   String?
  isCorrect        Boolean  @default(false)
  // How many positions matched. Not used for scoring (all-or-nothing) but
  // shown on the reveal screen so a student sees how close they were.
  correctPositions Int      @default(0)
  marks            Int      @default(0)
  // Submitted past the question's time limit. Still graded and shown to the
  // student, but scores zero. Stored rather than inferred from marks = 0, which
  // is indistinguishable from an ordinary wrong answer.
  late             Boolean  @default(false)
  // Measured server-side from settings.round2QuestionOpenedAt.
  // Never trusted from the client.
  responseTimeMs   Int
  isTest           Boolean  @default(false)
  answeredAt       DateTime @default(now())

  participant      Participant        @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question         Round2LiveQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionId])
  @@index([questionId])
  @@index([questionNumber])
  @@index([isTest])
  @@index([isCorrect])
}

// ============================================================
// ROUND 2 — PER-STUDENT QUESTION CLOCK
// ============================================================
// Round 2 is self-paced: every question is open for the whole event and each
// student's timer starts when THEY open it, exactly as Round1Attempt.startedAt
// works for Round 1.
//
// This is the piece the earlier attempt lacked. Timing then came from a single
// CompetitionSettings.round2QuestionOpenedAt — one clock for the whole hall —
// which is why only one question could ever be in play: there was nowhere to
// record when a particular student started a particular question.
//
// The unique constraint makes the clock start once. A student who reloads,
// switches phone or comes back later resumes the same start time rather than
// being handed a fresh one, so refreshing cannot buy a better time.
model Round2LiveStart {
  id            String   @id @default(cuid())
  participantId String
  questionId    String
  startedAt     DateTime @default(now())
  isTest        Boolean  @default(false)

  participant   Participant        @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question      Round2LiveQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionId])
  @@index([questionId])
}
