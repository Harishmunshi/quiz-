# ---------- Dependencies ----------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Next.js build output ----------
/.next/
/out/
/build/
next-env.d.ts

# ---------- Production standalone bundle ----------
/.next/standalone/
/.next/static/

# ---------- Testing / coverage ----------
/coverage
*.lcov
.nyc_output

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- Env / secrets ----------
# Real env files. `.env.example` is committed; `.env*` is not.
.env
.env.local
.env.*.local

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev.log
dev.out.log
server.log

# ---------- OS / editor noise ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---------- Vercel ----------
.vercel

# ---------- Local DB / Prisma ----------
/prisma/dev.db
/prisma/dev.db-journal
/prisma/migrations/dev/

# ---------- Sandbox / runtime leftover (if any) ----------
.claude
.z-ai-config
local-*
/skills/

# ---------- Misc ----------
*.pem
*.pid

# ---------- Local one-off leftovers (safe to delete the folders) ----------
_git_old_to_discard/
_git_old_to_discard
_env_old_to_discard/
_env_old_to_discard
_backup-noise-to-remove/

# npm lockfile � this project uses bun (see bun.lock)
package-lock.json

.vercel
.env*
