# ============================================================
# Islamic Quiz Competition - Environment Variables (template)
# Copy this file to `.env` and fill in real values.
# NEVER commit a real `.env` to git.
# ============================================================

# ---------- Database (Supabase Postgres) ----------
#
# The app runs on Postgres in every environment. SQLite is NOT supported:
# Vercel's filesystem is read-only and ephemeral, so a `file:` URL fails on
# every request with PrismaClientInitializationError.
#
# Find these in Supabase: Project Settings -> Database -> Connection string.
#
# DATABASE_URL = the POOLED connection (Transaction mode, port 6543).
#   Serverless functions open and drop connections constantly; the pooler is
#   what stops a hall full of students exhausting Postgres' connection limit.
#   `pgbouncer=true` is required — without it Prisma tries to use prepared
#   statements, which the transaction pooler does not support.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = the DIRECT connection (Session mode, port 5432).
#   Used only by `prisma migrate` / `prisma db push`, which need a real
#   session and cannot run through pgBouncer.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------- Supabase (optional: Storage / Realtime) ----------
# Public, safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only. NEVER expose this to client code.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage bucket for school assets (logo, etc.). Create it in Supabase Storage.
SUPABASE_STORAGE_BUCKET="school-assets"

# ---------- Admin bootstrap ----------
# Used by the seed step to create the first admin user.
# Default credentials are admin@mes.edu / admin123 — change immediately after first login.
ADMIN_BOOTSTRAP_EMAIL="admin@mes.edu"
ADMIN_BOOTSTRAP_PASSWORD="admin123"
ADMIN_BOOTSTRAP_NAME="Competition Admin"

# ---------- Admin session signing ----------
# REQUIRED in production. Admin tokens are HMAC-signed with this value; the
# app refuses to start admin auth without it. Generate with:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-secret-in-production"

# ---------- App ----------
NEXT_PUBLIC_APP_NAME="Islamic Quiz Competition"
NEXT_PUBLIC_SCHOOL_NAME="M.E.S. English Medium School"
NEXT_PUBLIC_PUBLIC_URL="http://localhost:3000"
